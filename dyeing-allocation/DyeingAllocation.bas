Attribute VB_Name = "DyeingAllocation"
Option Explicit

'==============================================================================
'  Dyeing Allocation Board  -  version 2 (performance & integrity revision)
'
'  * Data sheet is the master record. Column layout A:T is NOT changed.
'  * Public macro names are unchanged, so the existing buttons keep working.
'  * Data is read in ONE block into memory; the board is drawn by copying a
'    pre-formatted card template (BoardMap!A22:C33) instead of merging and
'    bordering every cell one by one.
'  * LEFT / RIGHT / GRAY RECEIVED / COMPLETE / CHANGE MACHINE / SAVE only
'    redraw the cards whose content or position actually changed.
'  * Mode (ALL / FILTER) and the number of drawn queue columns are kept in
'    BoardMap!B18:B19. (Old version used BoardMap!O2:O3, which lies INSIDE the
'    auto-expanding map area and was being erased/overwritten.)
'==============================================================================

' ---- Board layout (unchanged) ------------------------------------------------
Private Const FIRST_ROW As Long = 8
Private Const BLOCK_ROWS As Long = 13
Private Const CARD_ROWS As Long = 12
Private Const FIRST_COL As Long = 4
Private Const CARD_COLS As Long = 3
Private Const INITIAL_SLOTS As Long = 12
Private Const MACHINE_COUNT As Long = 14
Private Const GRAY_BLUE As Long = 15261367          ' RGB(183,222,232) = #B7DEE8

' ---- Data sheet columns (unchanged) ------------------------------------------
Private Const DATA_COLS As Long = 20
Private Const C_ID As Long = 1
Private Const C_MACHINE As Long = 2
Private Const C_QUEUE As Long = 3
Private Const C_PO As Long = 4
Private Const C_COLOR As Long = 5
Private Const C_FABRIC1 As Long = 6                 ' Fabric n = 6+2(n-1), Kg n = 7+2(n-1)
Private Const C_REMARKS As Long = 12
Private Const C_TOTAL As Long = 13
Private Const C_BATCH As Long = 14
Private Const C_FREQ As Long = 15
Private Const C_TNA As Long = 16
Private Const C_GNEED As Long = 17
Private Const C_GRAY As Long = 18
Private Const C_STATUS As Long = 19
Private Const C_DONE As Long = 20

' ---- BoardMap: system state + card template (outside the map B1:?15) -------
Private Const STATE_TITLE_CELL As String = "A17"
Private Const STATE_TITLE As String = "SYSTEM STATE (used by macros - do not edit)"
Private Const STATE_MODE As String = "B18"
Private Const STATE_SLOTS As String = "B19"
Private Const TPL_ROW As Long = 22
Private Const TPL_MARK_CELL As String = "A21"
Private Const TPL_MARK As String = "CARD TEMPLATE v2 (auto-generated by macro - do not edit)"

' ---- Application state -------------------------------------------------------
Private mFast As Boolean
Private mCalc As Long
Private mNotice As String

' ---- In-memory model of the Data sheet ---------------------------------------
Private gData As Variant                            ' Data!A1:T(last)  (row 1 = header)
Private gLast As Long
Private gMach(1 To MACHINE_COUNT) As String         ' machine names from BoardMap!A2:A15
Private gOrd() As Long                              ' gOrd(machine, position) = Data row
Private gCnt(1 To MACHINE_COUNT) As Long            ' cards per machine
Private gSlots As Long                              ' queue columns needed
Private gIdx As Collection                          ' ID -> Data row
Private gDup As Collection                          ' IDs that appear more than once
Private gUnknown As Long, gNoId As Long, gDupCount As Long

Private Function B() As Worksheet: Set B = ThisWorkbook.Worksheets("Allocation"): End Function
Private Function D() As Worksheet: Set D = ThisWorkbook.Worksheets("Data"): End Function
Private Function E() As Worksheet: Set E = ThisWorkbook.Worksheets("Editor"): End Function
Private Function M() As Worksheet: Set M = ThisWorkbook.Worksheets("BoardMap"): End Function

'==============================================================================
'  Excel application settings (always restored, also after errors)
'==============================================================================
Private Sub FastOn(ByVal msg As String)
    If mFast Then Exit Sub
    On Error Resume Next
    mCalc = 0
    mCalc = Application.Calculation
    If mCalc = 0 Then mCalc = xlCalculationAutomatic
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual
    Application.Cursor = xlWait
    Application.StatusBar = msg
    mFast = True
End Sub

Private Sub FastOff()
    On Error Resume Next
    If mFast Then Application.Calculation = mCalc
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.Cursor = xlDefault
    Application.StatusBar = False
    mFast = False
End Sub

Private Sub Finish(ByVal errMsg As String, ByVal title As String)
    FastOff
    If Len(errMsg) > 0 Then
        MsgBox title & ":" & vbLf & errMsg, vbExclamation
    ElseIf Len(mNotice) > 0 Then
        MsgBox mNotice, vbInformation
    End If
    mNotice = ""
End Sub

Private Function ErrText() As String
    ErrText = Err.Description & "  (Error " & Err.Number & ")"
End Function

' Emergency helper: Alt+F8 -> ResetExcelSettings, if Excel ever seems "frozen".
Public Sub ResetExcelSettings()
    On Error Resume Next
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic
    Application.Cursor = xlDefault
    Application.StatusBar = False
    mFast = False
End Sub

'==============================================================================
'  Setup
'==============================================================================
Public Sub SetupBoard()
    Dim labels As Variant, macros As Variant, i As Long, x As Double, s As Shape
    Dim errMsg As String
    labels = Array("LEFT", "RIGHT", "CHANGE MACHINE", "ADD", "EDIT", "GRAY RECEIVED", "COMPLETE", "REFRESH", "FILTER", "CLEAR FILTER")
    macros = Array("MoveLeft", "MoveRight", "ChangeMachine", "AddBatch", "EditBatch", "ToggleReceived", "CompleteBatch", "RefreshBoard", "ApplyFilter", "ClearFilter")
    mNotice = ""
    On Error GoTo Failed
    FastOn "Setting up board..."
    For i = B.Shapes.Count To 1 Step -1
        If Left$(B.Shapes(i).Name, 3) = "db_" Then B.Shapes(i).Delete
    Next i
    x = B.Range("A4").Left
    For i = LBound(labels) To UBound(labels)
        Set s = B.Shapes.AddShape(msoShapeRoundedRectangle, x, B.Range("A4").Top + 1, IIf(i = 2 Or i = 5 Or i = 9, 119, 76), 25)
        s.Name = "db_" & CStr(i)
        s.TextFrame.Characters.Text = CStr(labels(i))
        s.TextFrame.Characters.Font.Name = "Arial"
        s.TextFrame.Characters.Font.Size = 9
        s.TextFrame.Characters.Font.Bold = True
        s.TextFrame.Characters.Font.Color = RGB(255, 255, 255)
        s.Fill.ForeColor.RGB = IIf(i = 6, RGB(160, 75, 64), RGB(22, 98, 125))
        s.Line.Visible = msoFalse
        s.OnAction = "'" & ThisWorkbook.Name & "'!" & CStr(macros(i))
        s.Placement = xlFreeFloating
        x = x + s.Width + 5
    Next i
    For i = E.Shapes.Count To 1 Step -1
        If Left$(E.Shapes(i).Name, 3) = "db_" Then E.Shapes(i).Delete
    Next i
    AddEditorButton "db_Save", "SAVE BATCH", "SaveBatch", 1, RGB(22, 98, 125)
    AddEditorButton "db_Cancel", "CANCEL", "CancelEditor", 2, RGB(90, 102, 115)
    EnsureState
    RenderFull
    ShowBoardHome
    mNotice = "Board is ready. Select a card, then use the buttons in row 4."
Done:
    Finish errMsg, "Setup error"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Private Sub AddEditorButton(ByVal nm As String, ByVal caption As String, ByVal macroName As String, ByVal index As Long, ByVal colorVal As Long)
    Dim s As Shape
    Set s = E.Shapes.AddShape(msoShapeRoundedRectangle, E.Range("A22").Left + (index - 1) * 150, E.Range("A22").Top, 138, 27)
    s.Name = nm
    s.TextFrame.Characters.Text = caption
    s.TextFrame.Characters.Font.Name = "Arial"
    s.TextFrame.Characters.Font.Size = 10
    s.TextFrame.Characters.Font.Bold = True
    s.TextFrame.Characters.Font.Color = vbWhite
    s.Fill.ForeColor.RGB = colorVal
    s.Line.Visible = msoFalse
    s.OnAction = "'" & ThisWorkbook.Name & "'!" & macroName
End Sub

'==============================================================================
'  Small helpers
'==============================================================================
Private Function Txt(ByVal v As Variant) As String
    If IsError(v) Then Exit Function
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    Txt = CStr(v)
End Function

Private Function Num(ByVal v As Variant) As Double
    If IsError(v) Then Exit Function
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    If IsNumeric(v) Then Num = CDbl(v) Else Num = Val(CStr(v))
End Function

Private Function KeyOf(ByVal v As Variant) As String
    Dim s As String
    s = Trim$(Txt(v))
    If Len(s) = 0 Then Exit Function
    If IsNumeric(s) Then KeyOf = CStr(CDbl(s)) Else KeyOf = s
End Function

Private Function IsKg(ByVal v As Variant) As Boolean
    If IsError(v) Then Exit Function
    If Len(Trim$(Txt(v))) = 0 Then Exit Function
    IsKg = IsNumeric(v)
End Function

Private Function MaxL(ByVal a As Long, ByVal c As Long) As Long
    If a > c Then MaxL = a Else MaxL = c
End Function

' Text for a board cell. Keeps text that Excel would turn into a date/formula.
Private Function CellText(ByVal v As Variant) As Variant
    Dim s As String
    If IsError(v) Then CellText = Empty: Exit Function
    If IsEmpty(v) Or IsNull(v) Then CellText = Empty: Exit Function
    If VarType(v) <> vbString Then
        If IsNumeric(v) Then CellText = v: Exit Function
    End If
    s = Trim$(CStr(v))
    If Len(s) = 0 Then
        CellText = Empty
    ElseIf IsNumeric(s) Then
        CellText = s
    ElseIf IsDate(s) Or InStr(1, "=+-@", Left$(s, 1)) > 0 Then
        CellText = "'" & s
    Else
        CellText = s
    End If
End Function

' Text value from the Editor going to Data (protects forced-text input).
Private Function DataText(ByVal v As Variant) As Variant
    Dim s As String
    If VarType(v) <> vbString Then DataText = v: Exit Function
    s = CStr(v)
    If Len(s) = 0 Then
        DataText = Empty
    ElseIf IsNumeric(s) Or IsDate(s) Or InStr(1, "=+-@", Left$(s, 1)) > 0 Then
        DataText = "'" & s
    Else
        DataText = s
    End If
End Function

Private Function DateOrEmpty(ByVal v As Variant) As Variant
    DateOrEmpty = Empty
    If IsError(v) Then Exit Function
    If IsDate(v) Then DateOrEmpty = DateValue(CDate(v))
End Function

Private Function LastDataRow() As Long
    LastDataRow = D.Cells(D.Rows.Count, C_ID).End(xlUp).Row
End Function

' Last row that contains anything in A:T (protects rows whose ID cell is empty).
Private Function LastUsedDataRow() As Long
    Dim f As Range
    Set f = D.Range("A:T").Find(What:="*", After:=D.Range("A1"), LookIn:=xlFormulas, _
                                LookAt:=xlPart, SearchOrder:=xlByRows, SearchDirection:=xlPrevious)
    If f Is Nothing Then LastUsedDataRow = 1 Else LastUsedDataRow = f.Row
End Function

' Editor cells (B5:D19 are merged) - always address the whole merge area.
Private Function EdVal(ByVal addr As String) As Variant
    EdVal = E.Range(addr).MergeArea.Cells(1, 1).Value
End Function
Private Sub SetEd(ByVal addr As String, ByVal v As Variant)
    E.Range(addr).MergeArea.Cells(1, 1).Value = v
End Sub
Private Sub ClearEd(ByVal addr As String)
    E.Range(addr).MergeArea.ClearContents
End Sub

'==============================================================================
'  State (mode / drawn columns)
'==============================================================================
Private Sub EnsureState()
    If Txt(M.Range(STATE_TITLE_CELL).Value) <> STATE_TITLE Then
        M.Range(STATE_TITLE_CELL).Value = STATE_TITLE
        M.Range("A18").Value = "Mode"
        M.Range("A19").Value = "Drawn queue columns"
    End If
    If Len(Trim$(Txt(M.Range(STATE_MODE).Value))) = 0 Then M.Range(STATE_MODE).Value = "ALL"
End Sub

Private Function IsFiltered() As Boolean
    IsFiltered = (UCase$(Trim$(Txt(M.Range(STATE_MODE).Value))) = "FILTER")
End Function

Private Function RequireNormal() As Boolean
    If IsFiltered() Then
        MsgBox "Clear the date filter before changing batches.", vbExclamation
    Else
        RequireNormal = True
    End If
End Function

Private Function DateColumn() As Long
    Select Case Trim$(Txt(B.Range("U3").Value))
    Case "Fabric Request Date": DateColumn = C_FREQ
    Case "TNA Date": DateColumn = C_TNA
    Case "Gray Need Date": DateColumn = C_GNEED
    Case Else: DateColumn = 0
    End Select
End Function

' Number of queue columns currently drawn (robust even if the state cell is empty).
Private Function DrawnSlots() As Long
    Dim n As Long, lastCol As Long, rr As Long, maxSlots As Long
    n = CLng(Val(Txt(M.Range(STATE_SLOTS).Value)))
    lastCol = B.Cells(FIRST_ROW - 1, B.Columns.Count).End(xlToLeft).Column
    If lastCol >= FIRST_COL Then n = MaxL(n, (lastCol - FIRST_COL) \ CARD_COLS + 1)
    For rr = 2 To MACHINE_COUNT + 1
        lastCol = M.Cells(rr, M.Columns.Count).End(xlToLeft).Column
        n = MaxL(n, lastCol - 1)
    Next rr
    maxSlots = (B.Columns.Count - FIRST_COL + 1) \ CARD_COLS
    If n > maxSlots Then n = maxSlots
    If n < INITIAL_SLOTS Then n = INITIAL_SLOTS
    DrawnSlots = n
End Function

'==============================================================================
'  Model: read Data once, build the ordered card list per machine in memory
'==============================================================================
Private Sub LoadMachines()
    Dim mv As Variant, mi As Long
    mv = M.Range("A2").Resize(MACHINE_COUNT, 1).Value
    For mi = 1 To MACHINE_COUNT
        gMach(mi) = Trim$(Txt(mv(mi, 1)))
    Next mi
End Sub

Private Function MachineIndex(ByVal v As Variant) As Long
    Dim s As String, mi As Long
    s = Trim$(Txt(v))
    If Len(s) = 0 Then Exit Function
    For mi = 1 To MACHINE_COUNT
        If Len(gMach(mi)) > 0 Then
            If StrComp(s, gMach(mi), vbTextCompare) = 0 Then MachineIndex = mi: Exit Function
        End If
    Next mi
End Function

Private Function IsActiveRow(ByVal r As Long) As Boolean
    IsActiveRow = (UCase$(Trim$(Txt(gData(r, C_STATUS)))) <> "COMPLETED")
End Function

Private Function IsGrayReceived(ByVal r As Long) As Boolean
    IsGrayReceived = (UCase$(Trim$(Txt(gData(r, C_GRAY)))) = "YES")
End Function

Private Function RowMatchesFilter(ByVal r As Long, ByVal useFilter As Boolean, ByVal dateCol As Long, ByVal selDate As Date) As Boolean
    Dim v As Variant
    If Not useFilter Then RowMatchesFilter = True: Exit Function
    v = gData(r, dateCol)
    If IsError(v) Then Exit Function
    If IsDate(v) Then RowMatchesFilter = (DateValue(CDate(v)) = selDate)
End Function

Private Function AddKey(ByVal key As String, ByVal r As Long) As Boolean
    On Error Resume Next
    gIdx.Add r, key
    AddKey = (Err.Number = 0)
    Err.Clear
End Function

Private Sub AddDup(ByVal key As String)
    On Error Resume Next
    gDup.Add key, key
    Err.Clear
End Sub

Private Function IsDupKey(ByVal key As String) As Boolean
    Dim v As Variant
    If gDup Is Nothing Then Exit Function
    On Error Resume Next
    v = gDup.Item(key)
    IsDupKey = (Err.Number = 0)
    Err.Clear
End Function

Private Function RowOfKey(ByVal key As String) As Long
    Dim v As Variant
    If Len(key) = 0 Or gIdx Is Nothing Then Exit Function
    On Error Resume Next
    v = gIdx.Item(key)
    If Err.Number = 0 Then RowOfKey = CLng(v)
    Err.Clear
End Function

Private Function RowBefore(ByVal ra As Long, ByVal rb As Long) As Boolean
    Dim qa As Double, qb As Double
    qa = Num(gData(ra, C_QUEUE)): qb = Num(gData(rb, C_QUEUE))
    If qa < qb Then
        RowBefore = True
    ElseIf qa = qb Then
        RowBefore = (Num(gData(ra, C_ID)) < Num(gData(rb, C_ID)))
    End If
End Function

Private Sub SortBucket(ByVal mi As Long)
    Dim i As Long, j As Long, r As Long
    For i = 2 To gCnt(mi)
        r = gOrd(mi, i)
        j = i - 1
        Do While j >= 1
            If Not RowBefore(r, gOrd(mi, j)) Then Exit Do
            gOrd(mi, j + 1) = gOrd(mi, j)
            j = j - 1
        Loop
        gOrd(mi, j + 1) = r
    Next i
End Sub

Private Sub LoadModel(ByVal useFilter As Boolean, ByVal dateCol As Long, ByVal selDate As Date)
    Dim r As Long, mi As Long, key As String
    LoadMachines
    gLast = LastDataRow()
    If gLast < 1 Then gLast = 1
    gData = D.Range("A1").Resize(gLast, DATA_COLS).Value
    ReDim gOrd(1 To MACHINE_COUNT, 1 To gLast)
    For mi = 1 To MACHINE_COUNT: gCnt(mi) = 0: Next mi
    Set gIdx = New Collection
    Set gDup = New Collection
    gUnknown = 0: gNoId = 0: gDupCount = 0
    For r = 2 To gLast
        key = KeyOf(gData(r, C_ID))
        If Len(key) = 0 Then
            If IsActiveRow(r) And Len(Trim$(Txt(gData(r, C_MACHINE)))) > 0 Then gNoId = gNoId + 1
        Else
            If Not AddKey(key, r) Then
                gDupCount = gDupCount + 1
                AddDup key
            End If
            If IsActiveRow(r) Then
                mi = MachineIndex(gData(r, C_MACHINE))
                If mi = 0 Then
                    gUnknown = gUnknown + 1
                ElseIf RowMatchesFilter(r, useFilter, dateCol, selDate) Then
                    gCnt(mi) = gCnt(mi) + 1
                    gOrd(mi, gCnt(mi)) = r
                End If
            End If
        End If
    Next r
    gSlots = INITIAL_SLOTS
    For mi = 1 To MACHINE_COUNT
        SortBucket mi
        If gCnt(mi) > gSlots Then gSlots = gCnt(mi)
    Next mi
End Sub

' Find an ID in the (unfiltered) model: Data row, machine index, queue position.
Private Function LocateId(ByVal key As String, ByRef r As Long, ByRef mi As Long, ByRef pos As Long) As Boolean
    r = RowOfKey(key): mi = 0: pos = 0
    If r = 0 Then Exit Function
    If IsDupKey(key) Then Exit Function
    If Not IsActiveRow(r) Then Exit Function
    mi = MachineIndex(gData(r, C_MACHINE))
    If mi = 0 Then Exit Function
    For pos = 1 To gCnt(mi)
        If gOrd(mi, pos) = r Then LocateId = True: Exit Function
    Next pos
    pos = 0
End Function

Private Function MaxQueue(ByVal mi As Long) As Long
    Dim k As Long, q As Double
    For k = 1 To gCnt(mi)
        q = Num(gData(gOrd(mi, k), C_QUEUE))
        If q > MaxQueue Then MaxQueue = CLng(q)
    Next k
End Function

Private Function MaxId() As Double
    Dim r As Long, v As Double
    For r = 2 To gLast
        v = Num(gData(r, C_ID))
        If v > MaxId Then MaxId = v
    Next r
End Function

' Make Queue = 1..n for one machine, keeping the current order. Writes only changed cells.
Private Sub NormalizeQueue(ByVal mi As Long)
    Dim k As Long, r As Long, v As Variant
    If mi < 1 Then Exit Sub
    For k = 1 To gCnt(mi)
        r = gOrd(mi, k)
        v = gData(r, C_QUEUE)
        If Not IsKg(v) Then
            D.Cells(r, C_QUEUE).Value = k: gData(r, C_QUEUE) = k
        ElseIf CDbl(v) <> k Then
            D.Cells(r, C_QUEUE).Value = k: gData(r, C_QUEUE) = k
        End If
    Next k
End Sub

'==============================================================================
'  Rendering
'==============================================================================
Private Function CardRange(ByVal mi As Long, ByVal si As Long) As Range
    Set CardRange = B.Cells(FIRST_ROW + (mi - 1) * BLOCK_ROWS, FIRST_COL + (si - 1) * CARD_COLS).Resize(CARD_ROWS, CARD_COLS)
End Function

Private Function Tpl() As Range
    Set Tpl = M.Cells(TPL_ROW, 1).Resize(CARD_ROWS, CARD_COLS)
End Function

Private Sub BaseFormat(ByVal rng As Range)
    With rng
        .Font.Name = "Arial"
        .Font.Size = 9
        .HorizontalAlignment = xlLeft
        .VerticalAlignment = xlCenter
        .WrapText = False
    End With
End Sub

Private Sub TplMerge(ByVal t As Range, ByVal r As Long, ByVal c As Long, ByVal w As Long, ByVal isBold As Boolean, ByVal alignVal As Long)
    With t.Cells(r, c).Resize(1, w)
        .Merge
        .Font.Bold = isBold
        .HorizontalAlignment = alignVal
        .VerticalAlignment = xlCenter
        .ShrinkToFit = True
    End With
End Sub

Private Sub ThickEdge(ByVal rng As Range, ByVal edge As Long)
    With rng.Borders(edge)
        .LineStyle = xlContinuous
        .Weight = xlThick
        .Color = vbBlack
    End With
End Sub

' Builds ONE empty, fully formatted card (same layout as the original DrawCard).
Private Sub BuildTemplate()
    Dim t As Range, k As Long
    Set t = Tpl()
    t.UnMerge
    t.Clear
    BaseFormat t
    t.Font.Bold = False
    t.Interior.Color = vbWhite
    TplMerge t, 1, 1, 3, True, xlCenter                 ' PO
    TplMerge t, 2, 1, 3, True, xlCenter                 ' Color
    For k = 0 To 2
        TplMerge t, 3 + k, 1, 2, False, xlLeft          ' Fabric 1..3
        With t.Cells(3 + k, 3)                          ' Kg 1..3
            .NumberFormat = "#,##0.##""kg"""
            .HorizontalAlignment = xlRight
        End With
    Next k
    TplMerge t, 6, 1, 3, False, xlLeft                  ' Remarks
    TplMerge t, 7, 1, 3, True, xlCenter                 ' Total kg
    For k = 8 To 11                                     ' Batch No / 3 dates
        With t.Cells(k, 1)
            .Font.Bold = True
            .Font.Size = 8
        End With
        If k >= 9 Then t.Cells(k, 2).Resize(1, 2).NumberFormat = "yyyy/mm/dd"
        TplMerge t, k, 2, 2, False, xlLeft
    Next k
    TplMerge t, 12, 1, 3, True, xlCenter                ' Gray status
    t.Rows(12).Font.Size = 8
    For k = 8 To 12                                     ' fine inner lines
        With t.Rows(k).Borders(xlEdgeTop)
            .LineStyle = xlContinuous
            .Weight = xlThin
            .Color = vbBlack
        End With
    Next k
    ThickEdge t, xlEdgeLeft
    ThickEdge t, xlEdgeRight
    ThickEdge t, xlEdgeTop
    ThickEdge t, xlEdgeBottom
    M.Range(TPL_MARK_CELL).Value = TPL_MARK
End Sub

Private Sub EnsureTemplate()
    If Txt(M.Range(TPL_MARK_CELL).Value) <> TPL_MARK Then BuildTemplate
End Sub

Private Function CardValues(ByVal r As Long) As Variant
    Dim v(1 To CARD_ROWS, 1 To CARD_COLS) As Variant, k As Long, kg As Variant, total As Double
    v(1, 1) = CellText(gData(r, C_PO))
    v(2, 1) = CellText(gData(r, C_COLOR))
    For k = 0 To 2
        v(3 + k, 1) = CellText(gData(r, C_FABRIC1 + 2 * k))
        kg = gData(r, C_FABRIC1 + 2 * k + 1)
        If IsKg(kg) Then
            v(3 + k, 3) = CDbl(kg)
            total = total + CDbl(kg)
        End If
    Next k
    v(6, 1) = CellText(gData(r, C_REMARKS))
    v(7, 1) = Format$(total, "#,##0.##") & "kg"         ' Total = Kg1 + Kg2 + Kg3
    v(8, 1) = "Batch No":       v(8, 2) = CellText(gData(r, C_BATCH))
    v(9, 1) = "Fabric Request": v(9, 2) = DateOrEmpty(gData(r, C_FREQ))
    v(10, 1) = "TNA Date":      v(10, 2) = DateOrEmpty(gData(r, C_TNA))
    v(11, 1) = "Gray need Date": v(11, 2) = DateOrEmpty(gData(r, C_GNEED))
    If IsGrayReceived(r) Then v(12, 1) = "GRAY: RECEIVED" Else v(12, 1) = "GRAY: NOT RECEIVED"
    CardValues = v
End Function

Private Sub PutValues(ByVal rng As Range, ByVal v As Variant)
    Dim i As Long, j As Long
    On Error Resume Next
    rng.Value = v                                       ' one write per card
    If Err.Number = 0 Then Exit Sub
    Err.Clear
    On Error GoTo 0
    For i = 1 To CARD_ROWS                              ' fallback: anchor cells only
        For j = 1 To CARD_COLS
            If Not IsEmpty(v(i, j)) Then rng.Cells(i, j).Value = v(i, j)
        Next j
    Next i
End Sub

Private Sub DrawCard(ByVal mi As Long, ByVal si As Long, ByVal r As Long)
    Dim rng As Range
    Set rng = CardRange(mi, si)
    Tpl().Copy Destination:=rng.Cells(1, 1)             ' merges, borders, fonts, formats
    PutValues rng, CardValues(r)
    If IsGrayReceived(r) Then rng.Interior.Color = GRAY_BLUE
End Sub

Private Sub ClearCard(ByVal mi As Long, ByVal si As Long)
    Dim rng As Range
    Set rng = CardRange(mi, si)
    rng.UnMerge
    rng.Clear
    BaseFormat rng
    ' The left neighbour shares this edge - make sure its thick right border stays.
    If si > 1 And si - 1 <= gCnt(mi) Then ThickEdge CardRange(mi, si - 1), xlEdgeRight
End Sub

Private Sub WriteBoardMap(ByVal nCols As Long)
    Dim arr() As Variant, hdr() As Variant, mi As Long, si As Long
    If nCols < gSlots Then nCols = gSlots
    ReDim arr(1 To MACHINE_COUNT, 1 To nCols)
    ReDim hdr(1 To 1, 1 To nCols)
    For si = 1 To gSlots
        hdr(1, si) = "Q" & si
    Next si
    For mi = 1 To MACHINE_COUNT
        For si = 1 To gCnt(mi)
            arr(mi, si) = gData(gOrd(mi, si), C_ID)
        Next si
    Next mi
    M.Range("B1").Resize(1, nCols).Value = hdr
    M.Range("B2").Resize(MACHINE_COUNT, nCols).Value = arr
End Sub

Private Sub WriteStatus(ByVal useFilter As Boolean, ByVal selDate As Date)
    Dim s As String
    If useFilter Then
        s = "MODE: FILTERED  |  " & Txt(B.Range("U3").Value) & " = " & Format$(selDate, "yyyy/mm/dd") & "   |   Editing disabled"
    Else
        s = "MODE: ALL ACTIVE  |  Auto-expanding board (" & gSlots & " queue columns)  |  REFRESH after direct Data edits"
    End If
    If gUnknown > 0 Then s = s & "  |  WARNING: " & gUnknown & " active batch(es) have an unknown machine name (not shown)"
    If gNoId > 0 Then s = s & "  |  WARNING: " & gNoId & " active row(s) without ID (not shown)"
    If gDupCount > 0 Then s = s & "  |  WARNING: duplicate IDs in Data"
    B.Range("A5").Value = s
End Sub

' Full redraw: used by REFRESH, FILTER, CLEAR FILTER, SetupBoard and whenever
' the number of queue columns changes.
Private Sub RenderFull()
    Dim useFilter As Boolean, dateCol As Long, selDate As Date
    Dim oldSlots As Long, clearSlots As Long, mi As Long, si As Long, ci As Long, col0 As Long, k As Long
    Dim area As Range, h As Range
    EnsureState
    useFilter = IsFiltered()
    dateCol = DateColumn()
    If useFilter Then
        If dateCol = 0 Or Not IsDate(B.Range("X3").Value) Then
            Err.Raise vbObjectError + 600, , "Choose a date field (U3) and a valid date (X3), or press CLEAR FILTER."
        End If
        selDate = DateValue(CDate(B.Range("X3").Value))
    End If
    LoadModel useFilter, dateCol, selDate
    oldSlots = DrawnSlots()
    clearSlots = MaxL(oldSlots, gSlots)

    Set area = B.Range(B.Cells(FIRST_ROW, FIRST_COL), _
                       B.Cells(FIRST_ROW + MACHINE_COUNT * BLOCK_ROWS - 1, FIRST_COL + clearSlots * CARD_COLS - 1))
    area.UnMerge
    area.Clear
    BaseFormat area

    For ci = 1 To gSlots
        col0 = FIRST_COL + (ci - 1) * CARD_COLS
        If ci > INITIAL_SLOTS Then
            For k = 0 To CARD_COLS - 1
                If B.Columns(col0 + k).ColumnWidth <> B.Columns(FIRST_COL + k).ColumnWidth Then
                    B.Columns(col0 + k).ColumnWidth = B.Columns(FIRST_COL + k).ColumnWidth
                End If
            Next k
        End If
        Set h = B.Cells(FIRST_ROW - 1, col0).Resize(1, CARD_COLS)
        h.UnMerge
        h.Merge
        h.Cells(1, 1).Value = "QUEUE " & Format$(ci, "00")
        h.Interior.Color = RGB(23, 50, 75)
        h.Font.Name = "Arial": h.Font.Bold = True: h.Font.Size = 9: h.Font.Color = vbWhite
        h.HorizontalAlignment = xlCenter
    Next ci
    For ci = gSlots + 1 To clearSlots
        Set h = B.Cells(FIRST_ROW - 1, FIRST_COL + (ci - 1) * CARD_COLS).Resize(1, CARD_COLS)
        h.UnMerge
        h.Clear
    Next ci

    BuildTemplate
    For mi = 1 To MACHINE_COUNT
        For si = 1 To gCnt(mi)
            DrawCard mi, si, gOrd(mi, si)
        Next si
    Next mi
    WriteBoardMap clearSlots
    M.Range(STATE_SLOTS).Value = gSlots
    WriteStatus useFilter, selDate
End Sub

' Partial redraw: re-reads Data, compares with BoardMap and redraws only the
' cards whose ID changed (plus the card of dirtyKey, whose content changed).
Private Sub RenderChanges(Optional ByVal dirtyKey As String = "")
    Dim oldMap As Variant, mi As Long, si As Long, newK As String, oldK As String, tplOk As Boolean
    If IsFiltered() Then RenderFull: Exit Sub
    LoadModel False, 0, CDate(0)
    If CLng(Val(Txt(M.Range(STATE_SLOTS).Value))) <> gSlots Then RenderFull: Exit Sub
    oldMap = M.Range("B2").Resize(MACHINE_COUNT, gSlots).Value
    For mi = 1 To MACHINE_COUNT
        For si = 1 To gSlots
            newK = ""
            If si <= gCnt(mi) Then newK = KeyOf(gData(gOrd(mi, si), C_ID))
            oldK = KeyOf(oldMap(mi, si))
            If newK <> oldK Or (Len(newK) > 0 And newK = dirtyKey) Then
                If Len(newK) = 0 Then
                    ClearCard mi, si
                Else
                    If Not tplOk Then EnsureTemplate: tplOk = True
                    CardRange(mi, si).UnMerge
                    DrawCard mi, si, gOrd(mi, si)
                End If
            End If
        Next si
    Next mi
    WriteBoardMap gSlots
    WriteStatus False, CDate(0)
End Sub

Private Sub ShowBoardHome()
    B.Activate
    B.Range("A5").Select
End Sub

Private Sub SelectCard(ByVal mi As Long, ByVal si As Long)
    B.Activate
    CardRange(mi, si).Cells(1, 1).Select
End Sub

' Board was changed outside the macros (or ID is duplicated): redraw and tell the user.
Private Sub BoardOutOfDate(ByVal key As String)
    FastOn "Refreshing board..."
    If IsDupKey(key) Then
        mNotice = "Batch ID " & key & " exists more than once in the Data sheet." & vbLf & _
                  "Fix the ID column in Data (every ID must be unique), then press REFRESH."
    Else
        mNotice = "The board was out of date (Data was changed directly) and has been refreshed." & vbLf & _
                  "Please select the card again and repeat the action."
    End If
    RenderFull
    ShowBoardHome
End Sub

'==============================================================================
'  Card selection on the Allocation sheet
'==============================================================================
Private Function GetSelectedCard(ByRef mi As Long, ByRef si As Long, ByRef key As String) As Boolean
    Dim a As Range
    If Not ActiveSheet Is B Then
        MsgBox "Please select a batch card on Allocation.", vbExclamation
        Exit Function
    End If
    Set a = ActiveCell
    If a.Row < FIRST_ROW Or a.Column < FIRST_COL Then GoTo NotCard
    mi = (a.Row - FIRST_ROW) \ BLOCK_ROWS + 1
    si = (a.Column - FIRST_COL) \ CARD_COLS + 1
    If mi < 1 Or mi > MACHINE_COUNT Or si < 1 Or si > DrawnSlots() Then GoTo NotCard
    If (a.Row - FIRST_ROW) Mod BLOCK_ROWS >= CARD_ROWS Then GoTo NotCard
    key = KeyOf(M.Cells(mi + 1, si + 1).Value)
    If Len(key) = 0 Then GoTo NotCard
    GetSelectedCard = True
    Exit Function
NotCard:
    MsgBox "Select a filled batch card first.", vbExclamation
End Function

'==============================================================================
'  Buttons
'==============================================================================
Public Sub RefreshBoard()
    Dim errMsg As String
    mNotice = ""
    On Error GoTo Failed
    FastOn "Refreshing board..."
    RenderFull
    ShowBoardHome
Done:
    Finish errMsg, "Refresh failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub MoveLeft(): MoveStep -1: End Sub
Public Sub MoveRight(): MoveStep 1: End Sub

Private Sub MoveStep(ByVal stepVal As Long)
    Dim errMsg As String, mi As Long, si As Long, key As String
    Dim r As Long, r2 As Long, mm As Long, pos As Long, newPos As Long
    mNotice = ""
    If Not RequireNormal() Then Exit Sub
    If Not GetSelectedCard(mi, si, key) Then Exit Sub
    On Error GoTo Failed
    FastOn "Moving batch..."
    LoadModel False, 0, CDate(0)
    If Not LocateId(key, r, mm, pos) Then BoardOutOfDate key: GoTo Done
    newPos = pos + stepVal
    If newPos >= 1 And newPos <= gCnt(mm) Then
        NormalizeQueue mm                       ' Queue = 1..n first (repairs gaps/duplicates)
        r2 = gOrd(mm, newPos)
        D.Cells(r, C_QUEUE).Value = newPos      ' swap the two positions
        D.Cells(r2, C_QUEUE).Value = pos
        RenderChanges                           ' redraws only the two cards
        SelectCard mm, newPos                   ' keep the moved card selected
    End If
Done:
    Finish errMsg, "Move failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub ChangeMachine()
    Dim errMsg As String, mi As Long, si As Long, key As String, ans As String, prompt As String
    Dim r As Long, oldMi As Long, newMi As Long, pos As Long, k As Long
    mNotice = ""
    If Not RequireNormal() Then Exit Sub
    If Not GetSelectedCard(mi, si, key) Then Exit Sub
    On Error GoTo Failed
    LoadModel False, 0, CDate(0)
    If Not LocateId(key, r, oldMi, pos) Then BoardOutOfDate key: GoTo Done
    prompt = "Move to which machine? Type the NUMBER or the name:" & vbLf
    For k = 1 To MACHINE_COUNT
        prompt = prompt & vbLf & k & "  :  " & gMach(k)
    Next k
    ans = Trim$(InputBox(prompt, "CHANGE MACHINE", gMach(oldMi)))
    If Len(ans) = 0 Then GoTo Done
    newMi = 0
    If ans Like "#" Or ans Like "##" Then
        If CLng(ans) >= 1 And CLng(ans) <= MACHINE_COUNT Then newMi = CLng(ans)
    End If
    If newMi = 0 Then newMi = MachineIndex(ans)
    If newMi = 0 Then MsgBox "Unknown machine. Choose a number 1-" & MACHINE_COUNT & " or a name from the list.", vbExclamation: GoTo Done
    If newMi = oldMi Then GoTo Done
    FastOn "Changing machine..."
    D.Cells(r, C_MACHINE).Value = gMach(newMi)              ' canonical spelling
    D.Cells(r, C_QUEUE).Value = MaxQueue(newMi) + 1         ' end of the target queue
    LoadModel False, 0, CDate(0)
    NormalizeQueue oldMi
    NormalizeQueue newMi
    RenderChanges
    If LocateId(key, r, mi, pos) Then SelectCard mi, pos Else ShowBoardHome
Done:
    Finish errMsg, "Change machine failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub AddBatch()
    Dim i As Long
    If Not RequireNormal() Then Exit Sub
    On Error GoTo Failed
    LoadMachines
    SetEd "B2", "ADD"
    ClearEd "B3"
    For i = 5 To 19
        ClearEd "B" & i                         ' merged-cell safe
    Next i
    SetEd "B18", gMach(1)
    SetEd "B19", "No"
    E.Activate
    E.Range("B5").Select
    Exit Sub
Failed:
    MsgBox "Could not open the editor: " & ErrText(), vbExclamation
End Sub

Public Sub EditBatch()
    Dim mi As Long, si As Long, key As String, r As Long, mm As Long, pos As Long, errMsg As String
    mNotice = ""
    If Not RequireNormal() Then Exit Sub
    If Not GetSelectedCard(mi, si, key) Then Exit Sub
    On Error GoTo Failed
    LoadModel False, 0, CDate(0)
    If Not LocateId(key, r, mm, pos) Then BoardOutOfDate key: GoTo Done
    SetEd "B2", "EDIT"
    SetEd "B3", gData(r, C_ID)
    SetEd "B5", gData(r, C_PO)
    SetEd "B6", gData(r, C_COLOR)
    SetEd "B7", gData(r, 6):  SetEd "B8", gData(r, 7)
    SetEd "B9", gData(r, 8):  SetEd "B10", gData(r, 9)
    SetEd "B11", gData(r, 10): SetEd "B12", gData(r, 11)
    SetEd "B13", gData(r, C_REMARKS)
    SetEd "B14", gData(r, C_BATCH)
    SetEd "B15", gData(r, C_FREQ)
    SetEd "B16", gData(r, C_TNA)
    SetEd "B17", gData(r, C_GNEED)
    SetEd "B18", gMach(mm)
    SetEd "B19", gData(r, C_GRAY)
    E.Activate
    E.Range("B5").Select
Done:
    Finish errMsg, "Could not open the editor"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Private Function EditorDateOk(ByVal addr As String) As Boolean
    Dim v As Variant
    v = EdVal(addr)
    If IsError(v) Then Exit Function
    EditorDateOk = (Len(Trim$(Txt(v))) = 0 Or IsDate(v))
End Function

Private Function EditorKg(ByVal addr As String) As Variant
    Dim v As Variant
    v = EdVal(addr)
    If Len(Trim$(Txt(v))) = 0 Then EditorKg = Empty Else EditorKg = CDbl(v)
End Function

Private Function EditorDate(ByVal addr As String) As Variant
    Dim v As Variant
    v = EdVal(addr)
    If Len(Trim$(Txt(v))) = 0 Then EditorDate = Empty Else EditorDate = DateValue(CDate(v))
End Function

Public Sub SaveBatch()
    Dim errMsg As String, modeStr As String, batchNo As String, key As String
    Dim newMi As Long, oldMi As Long, r As Long, i As Long, mi As Long, pos As Long
    Dim kgAddr As Variant, v As Variant, newId As Double
    Dim rowArr(1 To 1, 1 To DATA_COLS) As Variant, part() As Variant
    mNotice = ""
    On Error GoTo Failed

    ' ---------- 1. validate everything BEFORE anything is written ----------
    modeStr = UCase$(Trim$(Txt(EdVal("B2"))))
    If modeStr <> "ADD" And modeStr <> "EDIT" Then MsgBox "Start from ADD or EDIT on Allocation.", vbExclamation: GoTo Done
    If IsFiltered() Then MsgBox "Clear the date filter (Allocation > CLEAR FILTER) before saving.", vbExclamation: GoTo Done
    batchNo = Trim$(Txt(EdVal("B14")))
    If Len(batchNo) = 0 Then MsgBox "Batch No is required.", vbExclamation: GoTo Done
    LoadModel False, 0, CDate(0)
    newMi = MachineIndex(EdVal("B18"))
    If newMi = 0 Then MsgBox "Select a valid machine.", vbExclamation: GoTo Done
    If Not EditorDateOk("B15") Or Not EditorDateOk("B16") Or Not EditorDateOk("B17") Then
        MsgBox "Enter valid dates (yyyy/mm/dd), or leave blank.", vbExclamation: GoTo Done
    End If
    kgAddr = Array("B8", "B10", "B12")
    For i = LBound(kgAddr) To UBound(kgAddr)
        v = EdVal(CStr(kgAddr(i)))
        If IsError(v) Then MsgBox "Kg must be numeric.", vbExclamation: GoTo Done
        If Len(Trim$(Txt(v))) > 0 Then
            If Not IsNumeric(v) Then MsgBox "Kg must be numeric.", vbExclamation: GoTo Done
            If CDbl(v) < 0 Then MsgBox "Kg cannot be negative.", vbExclamation: GoTo Done
        End If
    Next i
    If modeStr = "EDIT" Then
        key = KeyOf(EdVal("B3"))
        r = RowOfKey(key)
        If r = 0 Then MsgBox "Record not found (ID " & key & ").", vbExclamation: GoTo Done
        If IsDupKey(key) Then MsgBox "ID " & key & " exists more than once in Data. Fix the Data sheet first.", vbExclamation: GoTo Done
    End If
    For i = 2 To gLast
        If i <> r Then
            If StrComp(Trim$(Txt(gData(i, C_BATCH))), batchNo, vbTextCompare) = 0 Then
                If MsgBox("This Batch No already exists. Save anyway?", vbYesNo + vbExclamation) <> vbYes Then GoTo Done
                Exit For
            End If
        End If
    Next i

    ' ---------- 2. write ----------
    FastOn "Saving batch..."
    If modeStr = "ADD" Then
        r = MaxL(gLast, LastUsedDataRow()) + 1
        newId = MaxId() + 1
        key = KeyOf(newId)
    End If
    rowArr(1, C_PO) = DataText(EdVal("B5"))
    rowArr(1, C_COLOR) = DataText(EdVal("B6"))
    rowArr(1, 6) = DataText(EdVal("B7")):  rowArr(1, 7) = EditorKg("B8")
    rowArr(1, 8) = DataText(EdVal("B9")):  rowArr(1, 9) = EditorKg("B10")
    rowArr(1, 10) = DataText(EdVal("B11")): rowArr(1, 11) = EditorKg("B12")
    rowArr(1, C_REMARKS) = DataText(EdVal("B13"))
    rowArr(1, C_TOTAL) = "=SUM(G" & r & ",I" & r & ",K" & r & ")"
    rowArr(1, C_BATCH) = DataText(EdVal("B14"))
    rowArr(1, C_FREQ) = EditorDate("B15")
    rowArr(1, C_TNA) = EditorDate("B16")
    rowArr(1, C_GNEED) = EditorDate("B17")
    If UCase$(Trim$(Txt(EdVal("B19")))) = "YES" Then rowArr(1, C_GRAY) = "Yes" Else rowArr(1, C_GRAY) = "No"

    If modeStr = "ADD" Then
        rowArr(1, C_ID) = newId
        rowArr(1, C_MACHINE) = gMach(newMi)
        rowArr(1, C_QUEUE) = MaxQueue(newMi) + 1
        rowArr(1, C_STATUS) = "Active"
        D.Cells(r, 1).Resize(1, DATA_COLS).Value = rowArr          ' whole row in ONE write
    Else
        oldMi = MachineIndex(gData(r, C_MACHINE))
        ReDim part(1 To 1, 1 To C_GRAY - C_PO + 1)
        For i = C_PO To C_GRAY
            part(1, i - C_PO + 1) = rowArr(1, i)
        Next i
        D.Cells(r, C_PO).Resize(1, C_GRAY - C_PO + 1).Value = part ' columns D:R in ONE write
        If newMi <> oldMi Then
            D.Cells(r, C_MACHINE).Value = gMach(newMi)
            D.Cells(r, C_QUEUE).Value = MaxQueue(newMi) + 1
        ElseIf Trim$(Txt(gData(r, C_MACHINE))) <> gMach(newMi) Then
            D.Cells(r, C_MACHINE).Value = gMach(newMi)             ' normalise spelling only
        End If
    End If
    D.Cells(r, C_FREQ).Resize(1, 3).NumberFormat = "yyyy/mm/dd"

    LoadModel False, 0, CDate(0)
    If oldMi > 0 And oldMi <> newMi Then NormalizeQueue oldMi
    NormalizeQueue newMi
    RenderChanges key

    ' After ADD the editor switches to EDIT of the new record, so pressing
    ' SAVE again can never create a duplicate batch.
    SetEd "B2", "EDIT"
    SetEd "B3", gData(r, C_ID)
    If LocateId(key, r, mi, pos) Then SelectCard mi, pos Else ShowBoardHome
Done:
    Finish errMsg, "Could not save"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub CancelEditor()
    B.Activate
    B.Range("A5").Select
End Sub

Public Sub ToggleReceived()
    Dim errMsg As String, mi As Long, si As Long, key As String, r As Long, mm As Long, pos As Long
    mNotice = ""
    If Not RequireNormal() Then Exit Sub
    If Not GetSelectedCard(mi, si, key) Then Exit Sub
    On Error GoTo Failed
    FastOn "Updating gray status..."
    LoadModel False, 0, CDate(0)
    If Not LocateId(key, r, mm, pos) Then BoardOutOfDate key: GoTo Done
    If IsGrayReceived(r) Then D.Cells(r, C_GRAY).Value = "No" Else D.Cells(r, C_GRAY).Value = "Yes"
    RenderChanges key                           ' redraws just this card
    SelectCard mm, pos
Done:
    Finish errMsg, "Update failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub CompleteBatch()
    Dim errMsg As String, mi As Long, si As Long, key As String, r As Long, mm As Long, pos As Long
    Dim desc As String
    mNotice = ""
    If Not RequireNormal() Then Exit Sub
    If Not GetSelectedCard(mi, si, key) Then Exit Sub
    On Error GoTo Failed
    LoadModel False, 0, CDate(0)
    If Not LocateId(key, r, mm, pos) Then BoardOutOfDate key: GoTo Done
    desc = "Machine: " & gMach(mm) & "  /  Queue " & pos & vbLf & _
           "PO: " & Txt(gData(r, C_PO)) & vbLf & _
           "Color: " & Txt(gData(r, C_COLOR)) & vbLf & _
           "Batch No: " & Txt(gData(r, C_BATCH))
    If MsgBox("Mark this batch as COMPLETED?" & vbLf & vbLf & desc & vbLf & vbLf & _
              "It will disappear from the board but stay in Data.", vbYesNo + vbQuestion) <> vbYes Then GoTo Done
    FastOn "Completing batch..."
    D.Cells(r, C_STATUS).Value = "Completed"
    With D.Cells(r, C_DONE)
        .Value = Now
        .NumberFormat = "yyyy/mm/dd hh:mm"
    End With
    LoadModel False, 0, CDate(0)
    NormalizeQueue mm
    RenderChanges
    ShowBoardHome
Done:
    Finish errMsg, "Complete failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub ApplyFilter()
    Dim errMsg As String
    mNotice = ""
    If DateColumn() = 0 Then MsgBox "Choose a date field from U3.", vbExclamation: Exit Sub
    If Not IsDate(B.Range("X3").Value) Then MsgBox "Enter a valid single date in X3.", vbExclamation: Exit Sub
    On Error GoTo Failed
    FastOn "Filtering..."
    EnsureState
    M.Range(STATE_MODE).Value = "FILTER"
    RenderFull
    ShowBoardHome
Done:
    Finish errMsg, "Filter failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub

Public Sub ClearFilter()
    Dim errMsg As String
    mNotice = ""
    On Error GoTo Failed
    FastOn "Clearing filter..."
    EnsureState
    M.Range(STATE_MODE).Value = "ALL"
    RenderFull
    ShowBoardHome
Done:
    Finish errMsg, "Clear filter failed"
    Exit Sub
Failed:
    errMsg = ErrText()
    Resume Done
End Sub
